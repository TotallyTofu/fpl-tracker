# Copy to .env and fill in. All values here are optional — the app runs without any of them.
# Values in .env override config.json for the LLM (env wins when non-empty).

# Local LLM endpoint (OpenAI-compatible). The user configures these in the Settings UI too;
# the UI writes config.json, .env overrides it.
LLM_BASE_URL=http://localhost:8888/v1
LLM_API_KEY=
LLM_MODEL=